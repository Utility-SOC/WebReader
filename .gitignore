# Python
__pycache__/
*.pyc
*.egg-info/
.env

# Root virtual environment (created by run scripts as `python -m venv .`)
# Anchored to root so future source dirs named lib/bin/etc. aren't ignored
/Scripts/
/Lib/
/Include/
/bin/
/lib/
/share/
/pyvenv.cfg
.Python
venv/
.venv/

