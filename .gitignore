temp_uploads/
layouts/
/data/
backend/data/
*.db
*.pdf
*.log
build_log.txt

# Audio exports
*.wav
*.mp3

# Desktop build artifacts (PyInstaller / release packaging)
/build/
/dist/
/tesseract_bundle/
/desktop_release/
WebReader-*.zip
deploy/kubernetes/*.tgz
deploy/docker/data/

# License texts fetched at build time (committed ones are kept)
THIRD_PARTY_LICENSES/leptonica-license.txt
THIRD_PARTY_LICENSES/tesseract-dist-*

# Testing
.pytest_cache/
.coverage

